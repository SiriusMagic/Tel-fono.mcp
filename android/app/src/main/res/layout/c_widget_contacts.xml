<!-- «Contactos» widget (4×2): the title opens Contactos, the green button Teléfono, + a new contact; up to four favourites
     below (a tap opens Teléfono with their number ready; nothing calls by itself). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/c_widget_bg" android:paddingHorizontal="16dp" android:paddingVertical="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/c_widget_title" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/c_widget_icon" android:layout_width="32dp" android:layout_height="32dp" android:src="@mipmap/c_ic_launcher"
                android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="@string/c_app_name" android:textColor="#FFFFFF" android:textSize="18sp" />
        </LinearLayout>
        <ImageView android:id="@+id/c_widget_phone" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/c_widget_call_bg" android:padding="9dp" android:src="@drawable/ic_stat_call"
            android:contentDescription="@string/app_name" />
        <ImageView android:id="@+id/c_widget_add" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="8dp" android:background="@drawable/c_widget_add_bg" android:padding="8dp"
            android:src="@drawable/c_widget_add" android:contentDescription="@string/c_new_contact" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_widget_people" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" />
    <TextView android:id="@+id/c_widget_empty" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:textColor="#AAAAAA" android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
